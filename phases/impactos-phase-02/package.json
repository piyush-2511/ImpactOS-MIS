{
  "name": "impactos",
  "version": "0.1.0",
  "private": true,
  "description": "ImpactOS: multi-tenant operating system for Indian NGOs",
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "i18n:check": "tsx scripts/check-i18n.ts",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-alert-dialog": "1.1.24",
    "@radix-ui/react-avatar": "1.2.7",
    "@radix-ui/react-checkbox": "1.3.12",
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-dropdown-menu": "2.1.25",
    "@radix-ui/react-label": "2.1.16",
    "@radix-ui/react-popover": "1.2.0",
    "@radix-ui/react-progress": "1.1.17",
    "@radix-ui/react-radio-group": "1.4.8",
    "@radix-ui/react-select": "2.3.8",
    "@radix-ui/react-separator": "1.1.16",
    "@radix-ui/react-slot": "1.4.0",
    "@radix-ui/react-switch": "1.3.8",
    "@radix-ui/react-tabs": "1.1.22",
    "@radix-ui/react-tooltip": "1.3.0",
    "@react-email/render": "2.1.0",
    "@sentry/nextjs": "11.4.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "@upstash/ratelimit": "2.2.0",
    "@upstash/redis": "1.39.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "lucide-react": "1.52.0",
    "next": "16.3.8",
    "next-intl": "4.14.9",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-day-picker": "9.14.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "resend": "6.32.0",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "standardwebhooks": "1.1.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.9.9",
    "supabase": "2.119.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml}": [
      "prettier --write"
    ]
  },
  "packageManager": "npm@11.6.2"
}
