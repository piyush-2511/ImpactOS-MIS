# ImpactOS environment variables. Copy to .env.local. Each block notes the phase that starts using it.
# Phase 1 needs only the App block (and Sentry if you want error reports).
# --- App (phase 1) ---
NEXT_PUBLIC_APP_URL=https://app.theimpactos.in
NEXT_PUBLIC_ROOT_DOMAIN=theimpactos.in
ORG_COOKIE_SECRET=            # 32+ random bytes, signs the active-org cookie
CONSOLE_IP_ALLOWLIST=         # optional, comma-separated

# --- Supabase (phase 2) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=    # server only: jobs, webhooks, provisioning, console aggregates

# --- Auth extras (phase 2) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
SYNTHETIC_EMAIL_DOMAIN=users.id.theimpactos.in   # username accounts; never receives mail
SEND_EMAIL_HOOK_SECRET=       # Supabase Send Email hook secret (v1,whsec_...)
GOOGLE_SIGNIN_CLIENT_ID=      # Google sign-in (Supabase provider); not the Drive client
GOOGLE_SIGNIN_CLIENT_SECRET=

# --- Email (phase 2) ---
RESEND_API_KEY=
EMAIL_FROM=no-reply@mail.theimpactos.in
RECEIPTS_FROM=receipts@mail.theimpactos.in

# --- Storage (phase 4) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
GOOGLE_DRIVE_CLIENT_ID=       # separate OAuth client from Google sign-in
GOOGLE_DRIVE_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=         # 32 random bytes, base64: openssl rand -base64 32 (encrypts Drive tokens, sensitive fields)

# --- AI (phase 4; paid key, never free tier for customer data) ---
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=
AI_MODEL_LITE=
AI_MONTHLY_UNITS=5000         # per-organisation monthly AI allowance until plans set it (phase 5)

# --- Jobs / infra (Upstash from phase 2, Inngest phase 4, Sentry phase 1) ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
UPSTASH_REDIS_REST_URL=       # rate limits (phase 2); required in production
UPSTASH_REDIS_REST_TOKEN=
SENTRY_DSN=
VERCEL_API_TOKEN=             # custom domains for Enterprise
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
